{
  "name": "greekssurge-mcp",
  "version": "0.1.0",
  "description": "Read-only Model Context Protocol server for GreeksSurge account data.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/neerazz/greekssurge-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neerazz/greekssurge-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/neerazz/greekssurge-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "greekssurge",
    "options",
    "stdio",
    "read-only"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "greekssurge-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "docs/clients/*.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:check": "node scripts/verify-package.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "prepare": "npm run build",
    "prepublishOnly": "npm run format:check && npm run lint && npm run check && npm run test && npm run build && npm run audit:runtime && npm run scan:secrets && npm run pack:check",
    "start": "node dist/cli.js serve"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "ws": "^8.18.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.1.10"
  }
}
